---
const year = new Date().getFullYear()
---

<footer class="border-t border-white/5 px-4 py-6 text-sm text-zinc-400 sm:px-6">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p>
      RenPortal · Coyote Lab · Rodrigo Miquilino
      <span class="text-zinc-400"> · {year}</span>
    </p>
    <nav aria-label="Projeto" class="flex flex-wrap gap-x-4 gap-y-1">
      <a class="rounded-md hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="https://github.com/rodrigomiquilino/renportal">
        GitHub
      </a>
      <a class="rounded-md hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="https://rodrigomiquilino.github.io/renportal/">
        GitHub Pages
      </a>
      <a class="rounded-md hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href="https://github.com/rodrigomiquilino">
        @rodrigomiquilino
      </a>
    </nav>
  </div>
</footer>
