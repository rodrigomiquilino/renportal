---
import BaseLayout from './BaseLayout.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { ToastHost } from '../components/ToastHost'

interface Props {
  title: string
  description?: string
  heading: string
  lede: string
}

const { title, description, heading, lede } = Astro.props
const base = import.meta.env.BASE_URL
---

<BaseLayout title={title} description={description}>
  <div class="flex min-h-screen flex-col">
  <main id="conteudo" class="relative flex flex-1 items-center justify-center px-4 py-12">
    <div class="pointer-events-none absolute top-16 h-72 w-72 rounded-full bg-accent/20 blur-3xl"></div>
    <div class="relative w-full max-w-md rounded-2xl border border-white/5 bg-card p-6 shadow-2xl sm:p-8">
      <a href={base} class="flex items-center gap-2.5">
        <span class="grid h-9 w-9 place-items-center rounded-xl bg-accent text-sm font-bold text-white">R</span>
        <span class="text-lg font-semibold tracking-tight">RenPortal</span>
      </a>
      <h1 class="mt-6 text-2xl font-semibold tracking-tight">{heading}</h1>
      <p class="mt-2 text-sm leading-relaxed text-zinc-400">{lede}</p>
      <div class="mt-6">
        <slot />
      </div>
    </div>
  </main>
  <SiteFooter />
  </div>
  <ToastHost client:load />
</BaseLayout>
